# Local: deja SQLite. Render: reemplaza con la URI del pooler de Supabase.
DATABASE_URL=sqlite:///./sin_nombre.db
APP_SECRET=cambia-este-secreto
MAX_IMAGE_MB=5

# Opcional local; obligatorio en Render para conservar fotos.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=sin-nombre-media
